<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_reply_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_name"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textView_reply_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_content"
            android:textSize="12sp"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/button_edit_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit_reply"
        android:layout_marginEnd="8dp"/>

    <ImageButton
        android:id="@+id/button_delete_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_reply"/>

</LinearLayout>